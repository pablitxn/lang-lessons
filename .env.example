# Server-only credentials. Copy to .env.local; never put keys in VITE_* variables.
OPENAI_API_KEY=

# Optional model override. The broker default is gpt-realtime-2.1.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Optional server model for written hints, requested only when learning help is enabled.
# OPENAI_HINT_MODEL=gpt-6-luna

# Make voice available after configuring the key. Calls require Start tutor.
# The launcher honors this value; --voice / --no-voice override it for one run.
ALLOW_PAID_VOICE=1

# Authenticated application (server-only; supply real values outside source control).
# The local commands also load accounts.local/app.env when it exists.
# LEARNING_APPLICATION_CONFIG=/absolute/path/to/application.json
# LEARNING_DATABASE_URL=
# LEARNING_AUTH_SECRET=
# Separate explicit opt-in; requires a configured Phoenix collector.
# PHOENIX_CAPTURE_TRANSCRIPTS=false
