# Server-only credentials. Copy to .env.local; never put keys in VITE_* variables.
OPENAI_API_KEY=

# Optional model override. The broker default is gpt-realtime-2.1.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Optional server model for written hints, requested only when learning help is enabled.
# OPENAI_HINT_MODEL=gpt-6-luna

# Direct broker startup stays disabled unless explicitly opted in.
# scripts/dev-local.mjs overrides this based on its --voice argument.
ALLOW_PAID_VOICE=0
